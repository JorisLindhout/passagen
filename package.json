{
  "name": "passagen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "cf-typegen": "wrangler types --strict-vars=false",
    "audit": "esbuild scripts/audit-sources.ts --bundle --platform=node --format=esm --log-level=warning --outfile=audit/audit.mjs && node audit/audit.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.20.0"
  }
}
