{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "passagen",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "ART"
    }
  ],
  // Workers AI always runs on Cloudflare and is billed, even under `npm run dev`.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Counted per visitor address and per Cloudflare location. A visitor asks for three mazes on arrival
  // and one per maze walked; many visitors can share one address on mobile and venue networks.
  "ratelimits": [
    {
      "name": "WORKS_LIMIT",
      "namespace_id": "7301",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // CURATOR=off skips the AI and hangs random picks only. .dev.vars overrides both locally.
  "vars": {
    "CURATOR": "on",
    "CURATOR_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  // A deploy fails without it; local development only warns, and the Smithsonian slot goes to Chicago.
  // Set it in .dev.vars locally. The README's Deploy section covers the first deploy.
  "secrets": {
    "required": ["SMITHSONIAN_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
